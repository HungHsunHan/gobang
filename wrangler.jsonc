{
  "name": "gobang",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./worker.mjs",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/rooms", "/api/rooms/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
